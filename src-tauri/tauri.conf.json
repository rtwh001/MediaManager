{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaManager",
  "version": "0.1.0",
  "identifier": "com.local.mediamanager",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MediaManager",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/cache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "binaries/ffprobe.exe": "binaries/ffprobe.exe",
      "third-party/ffmpeg/LICENSE.txt": "third-party/ffmpeg/LICENSE.txt",
      "third-party/ffmpeg/NOTICE.txt": "third-party/ffmpeg/NOTICE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
